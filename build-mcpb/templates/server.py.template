# Logging setup
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
    stream=sys.stderr,
)
logger = logging.getLogger("mcp_{{name_underscore}}")

logger.info("{{service_name}} server module loading...")

# Create MCP server
mcp = FastMCP("{{service_name}}")

# Global client instance
_client: {{client_class}} | None = None


def get_client(ctx: Context | None = None) -> {{client_class}}:
    """Get or create the API client instance."""
    global _client
    if _client is None:
        api_key = os.environ.get("{{env_var_name}}")
        if not api_key:
            msg = "{{env_var_name}} environment variable is required"
            if ctx:
                ctx.error(msg)
            raise ValueError(msg)
        _client = {{client_class}}(api_key=api_key)
    return _client


# Health endpoint for HTTP transport
@mcp.custom_route("/health", methods=["GET"])
async def health_check(request: Request) -> JSONResponse:
    """Health check endpoint for monitoring."""
    return JSONResponse({"status": "healthy", "service": "mcp-{{name}}"})


